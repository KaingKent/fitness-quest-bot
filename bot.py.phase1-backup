import logging
import os
import uuid
from zoneinfo import ZoneInfo
from pathlib import Path

import asyncpg
import discord
from discord import app_commands
from discord.ext import commands, tasks
from dotenv import load_dotenv

load_dotenv(Path(__file__).resolve().parent / ".env")
logging.basicConfig(level=logging.INFO)
log = logging.getLogger("fitness-quest")
TZ = ZoneInfo("America/New_York")
TOKEN = os.environ["DISCORD_TOKEN"]
GUILD_ID = int(os.environ["DISCORD_GUILD_ID"])
DATABASE_URL = os.environ["DATABASE_URL"]
SHEET_ID = os.getenv("GOOGLE_SHEET_ID", "")
SERVICE_ACCOUNT_FILE = os.getenv("GOOGLE_SERVICE_ACCOUNT_FILE", "service-account.json")
WORKOUT_CHANNEL_ID = int(os.getenv("WORKOUT_CHANNEL_ID") or "0")

intents = discord.Intents.default()
bot = commands.Bot(command_prefix="!", intents=intents)
pool: asyncpg.Pool | None = None


def week_bounds(day: dt.date):
    start = day - dt.timedelta(days=day.weekday())
    return start, start + dt.timedelta(days=7)


async def ensure_player(user: discord.abc.User):
    async with pool.acquire() as con:
        await con.execute("""insert into players(discord_user_id,display_name)
            values($1,$2) on conflict(discord_user_id) do update
            set display_name=excluded.display_name""", user.id, user.display_name)


async def weekly_progress(user_id: int, day: dt.date):
    start, end = week_bounds(day)
    async with pool.acquire() as con:
        target = await con.fetchval("select weekly_target from players where discord_user_id=$1", user_id)
        count = await con.fetchval("""select count(*) from workouts where discord_user_id=$1
            and workout_date >= $2 and workout_date < $3""", user_id, start, end)
    count = min(count, target)
    # Python's round uses bankers rounding; positive integer formula uses half-up.
    partial = (30 * count * 2 + target) // (2 * target)
    return count, target, partial + (20 if count == target else 0)


async def publish_workout(interaction: discord.Interaction, workout_id: uuid.UUID):
    async with pool.acquire() as con:
        record = await con.fetchrow("select * from workouts where id=$1 and discord_user_id=$2", workout_id, interaction.user.id)
    if not record or record["visibility"] != "public":
        return
    channel = bot.get_channel(WORKOUT_CHANNEL_ID) if WORKOUT_CHANNEL_ID else None
    if not isinstance(channel, discord.TextChannel):
        return
    if record["public_message_id"]:
        return
    embed = discord.Embed(title="💪 Workout logged", description=f"**{discord.utils.escape_markdown(interaction.user.display_name)}** completed {record['workout_type']}!")
    embed.add_field(name="Duration", value=f"{record['duration_minutes']} minutes")
    embed.add_field(name="Date", value=str(record["workout_date"]))
    if record["notes"]:
        embed.add_field(name="Notes", value=record["notes"][:1024], inline=False)
    if record["image_discord_url"]:
        embed.set_image(url=record["image_discord_url"])
    msg = await channel.send(embed=embed, allowed_mentions=discord.AllowedMentions.none())
    async with pool.acquire() as con:
        await con.execute("update workouts set public_message_id=$1 where id=$2", msg.id, workout_id)


class WorkoutModal(discord.ui.Modal, title="Log your workout"):
    def __init__(self, workout_type: str):
        super().__init__()
        self.selected_workout_type = workout_type
        self.workout_date.default = dt.datetime.now(TZ).date().isoformat()

    duration = discord.ui.TextInput(label="Duration (minutes)", placeholder="45", max_length=4)
    workout_date = discord.ui.TextInput(label="Workout date (YYYY-MM-DD)", placeholder="2026-11-15", max_length=10)
    notes = discord.ui.TextInput(label="Notes (optional)", style=discord.TextStyle.paragraph, required=False, max_length=500)

    async def on_submit(self, interaction: discord.Interaction):
        try:
            minutes = int(str(self.duration))
            day = dt.date.fromisoformat(str(self.workout_date))
            today = dt.datetime.now(TZ).date()
            if not 1 <= minutes <= 1440 or day > today or day < today - dt.timedelta(days=14):
                raise ValueError
        except ValueError:
            await interaction.response.send_message("Please enter 1–1440 minutes and a valid date within the past 14 days.", ephemeral=True)
            return
        await ensure_player(interaction.user)
        workout_id = uuid.uuid4()
        async with pool.acquire() as con:
            async with con.transaction():
                await con.execute("""insert into workouts(id,discord_user_id,workout_date,workout_type,duration_minutes,notes,visibility)
                    values($1,$2,$3,$4,$5,$6,'private')""", workout_id, interaction.user.id,
                    day, self.selected_workout_type, minutes, str(self.notes).strip())
                await con.execute("insert into sync_outbox(workout_id,event_type) values($1,'upsert')", workout_id)
        count, target, xp = await weekly_progress(interaction.user.id, day)
        view = PostWorkoutView(workout_id)
        await interaction.response.send_message(
            f"✅ Workout saved privately. Week of {week_bounds(day)[0]}: **{count}/{target}** workouts, **{xp}/50** fitness XP.\n"
            "You can attach an optional image with `/workout_image`, or share this workout below.",
            view=view, ephemeral=True)


class PostWorkoutView(discord.ui.View):
    def __init__(self, workout_id: uuid.UUID):
        super().__init__(timeout=900)
        self.workout_id = workout_id

    @discord.ui.button(label="Share publicly", style=discord.ButtonStyle.primary, emoji="📣")
    async def share(self, interaction: discord.Interaction, button: discord.ui.Button):
        async with pool.acquire() as con:
            result = await con.execute("update workouts set visibility='public' where id=$1 and discord_user_id=$2", self.workout_id, interaction.user.id)
            await con.execute("insert into sync_outbox(workout_id,event_type) values($1,'upsert') on conflict do nothing", self.workout_id)
        if result.endswith("0"):
            await interaction.response.send_message("Workout not found.", ephemeral=True)
            return
        await interaction.response.defer(ephemeral=True)
        await publish_workout(interaction, self.workout_id)
        await interaction.followup.send("Shared in the workout channel (if configured).", ephemeral=True)


class WorkoutTypeSelect(discord.ui.Select):
    def __init__(self):
        super().__init__(
            placeholder="Choose your workout type...",
            min_values=1,
            max_values=1,
            options=[
                discord.SelectOption(label="Strength", emoji="🏋️", description="Weights and resistance training"),
                discord.SelectOption(label="Cardio", emoji="🏃", description="Running, cycling, and other cardio"),
                discord.SelectOption(label="Sports", emoji="⚽", description="Team or individual sports"),
                discord.SelectOption(label="Mobility", emoji="🧘", description="Stretching, yoga, and recovery"),
                discord.SelectOption(label="Other", emoji="✨", description="Anything else"),
            ],
        )

    async def callback(self, interaction: discord.Interaction):
        if interaction.user.id != self.view.owner_id:
            await interaction.response.send_message("Please use Log Workout to start your own form.", ephemeral=True)
            return
        await interaction.response.send_modal(WorkoutModal(self.values[0]))


class WorkoutTypeView(discord.ui.View):
    def __init__(self, owner_id: int):
        super().__init__(timeout=300)
        self.owner_id = owner_id
        self.add_item(WorkoutTypeSelect())


class HubView(discord.ui.View):
    def __init__(self):
        super().__init__(timeout=None)

    @discord.ui.button(label="Log Workout", style=discord.ButtonStyle.success, emoji="💪", custom_id="fitnessquest:log_workout")
    async def log_workout(self, interaction: discord.Interaction, button: discord.ui.Button):
        await interaction.response.send_message(
            "**Choose your workout type:**",
            view=WorkoutTypeView(interaction.user.id),
            ephemeral=True,
        )

    @discord.ui.button(label="My Progress", style=discord.ButtonStyle.secondary, emoji="📊", custom_id="fitnessquest:my_progress")
    async def progress(self, interaction: discord.Interaction, button: discord.ui.Button):
        await ensure_player(interaction.user)
        count, target, xp = await weekly_progress(interaction.user.id, dt.datetime.now(TZ).date())
        await interaction.response.send_message(f"This week: **{count}/{target}** workouts · **{xp}/50** fitness XP.", ephemeral=True)


@bot.tree.command(name="setup_hub", description="Post the permanent workout dashboard", guild=discord.Object(id=GUILD_ID))
@app_commands.default_permissions(manage_guild=True)
async def setup_hub(interaction: discord.Interaction):
    if not interaction.user.guild_permissions.manage_guild:
        await interaction.response.send_message("Manage Server permission required.", ephemeral=True)
        return
    await interaction.channel.send("# ⚔️ Fitness Quest\nLog your workouts below!", view=HubView())
    await interaction.response.send_message("Hub posted.", ephemeral=True)


@bot.tree.command(name="workout_image", description="Attach an image to one of your recent workouts", guild=discord.Object(id=GUILD_ID))
@app_commands.describe(image="Workout photo or screenshot", workout_id="UUID from /my_workouts")
async def workout_image(interaction: discord.Interaction, image: discord.Attachment, workout_id: str):
    if not image.content_type or not image.content_type.startswith("image/") or image.size > 8 * 1024 * 1024:
        await interaction.response.send_message("Please attach an image under 8 MB.", ephemeral=True)
        return
    try:
        wid = uuid.UUID(workout_id)
    except ValueError:
        await interaction.response.send_message("Invalid workout ID. Find it with /my_workouts.", ephemeral=True)
        return
    async with pool.acquire() as con:
        row = await con.fetchrow("select id,visibility from workouts where id=$1 and discord_user_id=$2", wid, interaction.user.id)
        if not row:
            await interaction.response.send_message("Workout not found.", ephemeral=True)
            return
        await con.execute("update workouts set image_discord_url=$1 where id=$2", image.url, wid)
        await con.execute("insert into sync_outbox(workout_id,event_type) values($1,'upsert') on conflict do nothing", wid)
    await interaction.response.send_message("📷 Image linked to your workout. Note: Discord attachment URLs are not permanent storage.", ephemeral=True)


@bot.tree.command(name="my_workouts", description="List your five most recent workouts", guild=discord.Object(id=GUILD_ID))
async def my_workouts(interaction: discord.Interaction):
    async with pool.acquire() as con:
        rows = await con.fetch("select id,workout_date,workout_type from workouts where discord_user_id=$1 order by created_at desc limit 5", interaction.user.id)
    content = "\n".join(f"{r['workout_date']} · {r['workout_type']} · `{r['id']}`" for r in rows) or "No workouts yet."
    await interaction.response.send_message(content, ephemeral=True)


def sync_sheet_once():
    """Synchronous worker called in a thread. Upserts rows by workout UUID."""
    import gspread
    client = gspread.service_account(filename=SERVICE_ACCOUNT_FILE)
    spreadsheet = client.open_by_key(SHEET_ID)
    try:
        sheet = spreadsheet.worksheet("Workout Logs")
    except gspread.WorksheetNotFound:
        sheet = spreadsheet.add_worksheet(title="Workout Logs", rows=1000, cols=10)
    return sheet


@tasks.loop(seconds=60)
async def sheet_sync():
    if not SHEET_ID or not os.path.isfile(SERVICE_ACCOUNT_FILE):
        return
    async with pool.acquire() as con:
        pending = await con.fetch("""select o.id as outbox_id,w.* from sync_outbox o join workouts w on w.id=o.workout_id
            where o.processed_at is null order by o.id limit 50""")
    if not pending:
        return
    try:
        sheet = await asyncio.to_thread(sync_sheet_once)
        headers = ["Workout ID", "Discord User ID", "Date", "Type", "Minutes", "Notes", "Visibility", "Image URL", "Created At"]
        values = await asyncio.to_thread(sheet.get_all_values)
        if not values or values[0] != headers:
            await asyncio.to_thread(sheet.update, range_name="A1:I1", values=[headers])
            values = await asyncio.to_thread(sheet.get_all_values)
        existing = {row[0]: i+1 for i,row in enumerate(values[1:], start=1) if row}
        for r in pending:
            row = [str(r["id"]),str(r["discord_user_id"]),str(r["workout_date"]),r["workout_type"],r["duration_minutes"],r["notes"],r["visibility"],r["image_discord_url"] or "",str(r["created_at"])]
            if str(r["id"]) in existing:
                idx = existing[str(r["id"])]
                await asyncio.to_thread(sheet.update, range_name=f"A{idx}:I{idx}", values=[row], value_input_option="RAW")
            else:
                await asyncio.to_thread(sheet.append_row, row, value_input_option="RAW")
            async with pool.acquire() as con:
                await con.execute("update sync_outbox set processed_at=now() where id=$1", r["outbox_id"])
    except Exception:
        log.exception("Google Sheets sync failed; will retry")


@sheet_sync.before_loop
async def before_sync():
    await bot.wait_until_ready()


@bot.event
async def on_ready():
    log.info("Connected as %s", bot.user)


async def main():
    global pool
    log.info("Connecting to Supabase...")
    pool = await asyncpg.create_pool(DATABASE_URL, min_size=1, max_size=5, ssl="require")
    log.info("Supabase connection pool initialized")
    try:
        async with bot:
            bot.add_view(HubView())
            await bot.login(TOKEN)
            await bot.tree.sync(guild=discord.Object(id=GUILD_ID))
            log.info("Discord slash commands synchronized")
            sheet_sync.start()
            await bot.connect()
    finally:
        if sheet_sync.is_running():
            sheet_sync.cancel()
        await pool.close()
        log.info("Supabase connection pool closed")


if __name__ == "__main__":
    asyncio.run(main())
